{
  "name": "nexovonarsa-whatsapp-cs-suite",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node bot/index.js",
    "dev": "node --watch bot/index.js",
    "test": "node --test tests/unit/*.test.js",
    "lint": "node scripts/check-runtime.mjs",
    "export": "python3 export/excel/generate_excel.py",
    "word": "python3 export/word/generate_word.py",
    "native": "g++ -std=c++17 native/src/native_helper.cpp -I native/include -O2 -o native/nexo_helper",
    "web": "python3 -m http.server 8080 --directory web/public"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "googleapis": "^159.0.0",
    "pino": "^9.6.0",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.34.3"
  }
}